{
  "name": "signage-control-panel",
  "private": true,
  "version": "0.1.0",
  "description": "Signage Control Panel - admin dashboard, realtime API, and device client",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev -w @signage/api",
    "dev:dashboard": "npm run dev -w @signage/dashboard",
    "dev:device": "npm run dev -w @signage/device",
    "build:api": "npm run build -w @signage/api",
    "build:dashboard": "npm run build -w @signage/dashboard",
    "build:device": "npm run build -w @signage/device",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
