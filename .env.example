# =====================================================================
# Signage Control Panel - Environment Configuration Template
# Salin file ini menjadi .env:
#   cp .env.example .env
# =====================================================================

# ---- API Server ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ---- Supabase (Project Settings > API) ----
# URL project Supabase Anda (contoh: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Service Role Key (SERVER ONLY, jangan pernah diekspos ke frontend / di-commit ke Git)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Nama bucket storage di Supabase untuk menampung file upload (image & video)
SUPABASE_STORAGE_BUCKET=contents

# ---- Auth (JWT) ----
# Minimal 16 karakter. Buat secret acak dengan perintah:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-random-jwt-secret-at-least-16-chars-long
JWT_EXPIRES_IN=8h

# Set true jika API berjalan di belakang reverse proxy / load balancer (Nginx / Caddy / Cloudflare)
TRUST_PROXY=false

# ---- Realtime / WebSocket ----
# Interval heartbeat ping ke device & dashboard (dalam milidetik, default 15000 = 15 detik)
WS_PING_INTERVAL_MS=15000
